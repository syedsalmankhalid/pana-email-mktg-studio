# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit a real key.
#
# Leave RESEND_API_KEY empty to stay in practice mode
# (local practice server at http://localhost:4000).

# Your Resend API key. Create one with "Sending access" only.
RESEND_API_KEY=

# Real Resend API. Used only when RESEND_API_KEY is set.
RESEND_BASE_URL=https://api.resend.com

# Sender address. Keep onboarding@resend.dev until you verify a domain.
SENDER_EMAIL_ADDRESS=onboarding@resend.dev
